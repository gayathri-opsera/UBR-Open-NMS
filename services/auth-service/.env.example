# Auth Service — Environment Variables
# Copy this to .env and fill in real values before running.

NODE_ENV=development
AUTH_PORT=3001

# MongoDB
MONGO_URI=mongodb://localhost:27017/ubr_nms

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# LDAP / NIAM
LDAP_URL=ldaps://niam.airtel.internal:636
LDAP_BASE_DN=dc=airtel,dc=internal
LDAP_BIND_DN=cn=nms-svc,dc=airtel,dc=internal
LDAP_BIND_PASSWORD=
LDAP_SEARCH_FILTER=(uid={{username}})
LDAP_TLS_REJECT_UNAUTHORIZED=true

# JWT — RS256 keys (base64-encoded PEM)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then: base64 -i private.pem | tr -d '\n'
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Session
MAX_CONCURRENT_SESSIONS=3
SESSION_IDLE_TIMEOUT_SECONDS=1800

# CORS
CORS_ORIGIN=http://localhost:3000
