{
  "name": "@ubr-nms/auth-service",
  "version": "0.1.0",
  "description": "Auth Service — LDAP/JWT authentication, RBAC, session management for UBR NMS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --forceExit",
    "test:unit": "jest --testPathPattern='tests/unit' --coverage --forceExit",
    "test:integration": "jest --testPathPattern='tests/integration' --forceExit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "ioredis": "^5.3.2",
    "ldapjs": "^3.0.7",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "opossum": "^8.1.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "projects": [
      {
        "displayName": "unit",
        "testMatch": ["<rootDir>/tests/unit/**/*.test.js"],
        "testEnvironment": "node",
        "collectCoverage": false
      },
      {
        "displayName": "integration",
        "testMatch": ["<rootDir>/tests/integration/**/*.test.js"],
        "testEnvironment": "node",
        "testTimeout": 30000,
        "collectCoverage": false
      }
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
