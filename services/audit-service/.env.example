PORT=3007
MONGO_URI=mongodb://localhost:27017/ubrnms_audit

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=audit-service
KAFKA_AUDIT_TOPIC=audit-events
KAFKA_ENABLED=true

# Syslog
SYSLOG_HOST=localhost
SYSLOG_PORT=514
SYSLOG_TRANSPORT=UDP
SYSLOG_APP_NAME=ubrnms-audit
SYSLOG_ENABLED=false

# Audit
AUDIT_TTL_DAYS=365
AUDIT_MAX_EXPORT_ROWS=10000

LOG_LEVEL=info
