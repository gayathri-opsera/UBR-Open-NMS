{
  "name": "@ubr-nms/api-gateway",
  "version": "0.1.0",
  "description": "API Gateway — JWT validation, RBAC, request routing, rate limiting for UBR NMS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:unit": "jest --testPathPattern=tests/unit --forceExit",
    "test:integration": "jest --testPathPattern=tests/integration --forceExit --runInBand",
    "test": "jest --forceExit --runInBand"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-http-proxy": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "ioredis": "^5.3.2",
    "opossum": "^8.1.1",
    "uuid": "^9.0.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": { "lines": 80 }
    }
  },
  "engines": { "node": ">=18.0.0" }
}
