PORT=3000
LOG_LEVEL=info

# JWT — RS256 public key from Auth Service (multi-line, base64-encoded or PEM)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=ubr-nms-auth
JWT_AUDIENCE=ubr-nms

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Circuit breaker
CB_TIMEOUT_MS=5000
CB_ERROR_PCT=50
CB_RESET_MS=30000

# Backend service URLs
AUTH_SERVICE_URL=http://auth-service:3001
INVENTORY_SERVICE_URL=http://inventory-service:3002
ALARM_SERVICE_URL=http://alarm-service:3003
CONFIG_SERVICE_URL=http://config-service:3004
KPI_SERVICE_URL=http://kpi-service:3005
TOPOLOGY_SERVICE_URL=http://topology-service:3006
DISCOVERY_SERVICE_URL=http://discovery-service:3007
AUDIT_SERVICE_URL=http://audit-service:3008
NOTIFICATION_SERVICE_URL=http://notification-service:3009
