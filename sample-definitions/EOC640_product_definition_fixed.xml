<?xml version="1.0" encoding="UTF-8"?>
<!--
  EOC640 Wireless Backhaul Unit — Product Definition
  Schema: urn:nms:productdef:1.0

  FIXES applied vs original upload:
  1. <identity>: renamed <id> → <name>, replaced <firmwareVer> with <firmwareFrom>/<firmwareTo>
  2. <fingerprints>: restructured from XML attributes to child elements;
     added <sysObjectId> (required by validator) + mapped match patterns to <sysDescrPattern>
  3. <protocols>: moved type from XML attribute to <type> child element
  4. <parameterGroups> → <parameters>; <parameterGroup id=""> → <group name="">
  5. Parameter id moved from XML attribute to <id> child element; <name> → <displayName>
  6. DataTypes: uint → INTEGER, ipv4 → IPADDRESS, ipv6 → IPADDRESS
-->
<productDefinition xmlns="urn:nms:productdef:1.0" schemaVersion="1.0">

  <!-- ══ IDENTITY ══ -->
  <identity>
    <!-- FIX #1: parser reads <name>, not <id> -->
    <name>EOC640 Wireless Backhaul Unit</name>
    <vendor>EOC</vendor>
    <model>EOC640 Wireless Backhaul Unit</model>
    <description>P2MP 60 GHz / 5 GHz backhaul radio supporting BTS and CPE roles</description>
    <!-- FIX #1b: parser reads <firmwareFrom>/<firmwareTo>, not <firmwareVer> -->
    <firmwareFrom>1.0</firmwareFrom>
    <firmwareTo>99.x</firmwareTo>
    <productFamily>EOC Wireless Backhaul</productFamily>
    <deviceType>WIRELESS_BACKHAUL</deviceType>
  </identity>

  <!-- ══ FINGERPRINTS ══
       FIX #2: original used XML attributes (type="sshBanner" match="EOC640.*").
       The parser reads child elements <sysObjectId> and <sysDescrPattern>.
       sysObjectId is REQUIRED by the validator and must be a valid dotted-numeric OID.
  ══ -->
  <fingerprints>
    <fingerprint>
      <!-- SSH banner fingerprint mapped to OID + sysDescr pattern -->
      <sysObjectId>.1.3.6.1.4.1.26928.1.640</sysObjectId>
      <sysDescrPattern>EOC640.*</sysDescrPattern>
      <firmwareFrom>1.0</firmwareFrom>
      <firmwareTo>99.x</firmwareTo>
    </fingerprint>
    <fingerprint>
      <!-- HTTP Server header fingerprint -->
      <sysObjectId>.1.3.6.1.4.1.26928.1.641</sysObjectId>
      <sysDescrPattern>EOC-.*</sysDescrPattern>
      <firmwareFrom>1.0</firmwareFrom>
      <firmwareTo>99.x</firmwareTo>
    </fingerprint>
  </fingerprints>

  <!-- ══ PROTOCOLS ══
       FIX #3: original used XML attribute type="rest". Parser reads <type> child element.
  ══ -->
  <protocols>
    <protocol>
      <type>REST</type>
    </protocol>
    <protocol>
      <type>CLI</type>
    </protocol>
  </protocols>

