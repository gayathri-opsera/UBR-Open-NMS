{
  "id": null,
  "uid": "noc-001",
  "title": "UBR NMS \u2014 NOC Operations",
  "tags": [
    "ubrnms",
    "noc"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Alarm Rate (alarms/min)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(kafka_messages_consumed_total{topic=\"raw-alarms\"}[1m]) * 60",
          "legendFormat": "Alarm rate/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Device Online/Offline",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "count(up{job=\"discovery-service\"} == 1)",
          "legendFormat": "Online",
          "refId": "A"
        },
        {
          "expr": "count(up{job=\"discovery-service\"} == 0)",
          "legendFormat": "Offline",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Alarm\u2192Dashboard Latency P99",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(alarm_correlation_latency_seconds_bucket[5m]))",
          "legendFormat": "histogram_quantile(0.99, rate(",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "max": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.7999999999999998
              },
              {
                "color": "red",
                "value": 2.7
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Netcool Forwarding Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(netcool_alarms_forwarded_total[1m]) * 60",
          "legendFormat": "Forwarded/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  }
}