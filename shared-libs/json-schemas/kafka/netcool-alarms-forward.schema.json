{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubr-nms.airtel.internal/schemas/kafka/netcool-alarms-forward.schema.json",
  "title": "NetcoolAlarmForwardMessage",
  "description": "Northbound Kafka message forwarded to Netcool OSS. Exact format from BRD Section 4.2.",
  "type": "object",
  "required": ["alarmId", "alarmName", "severity", "alarmDescription", "state", "Time", "data"],
  "properties": {
    "alarmId":          { "type": "string" },
    "alarmName":        { "type": "string" },
    "severity":         { "type": "string", "enum": ["CRITICAL", "MAJOR", "MINOR", "WARNING", "INDETERMINATE", "CLEARED"] },
    "alarmDescription": { "type": "string" },
    "state":            { "type": "string", "enum": ["RAISED", "ACKNOWLEDGED", "CLEARED"] },
    "Time":             { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "required": ["deviceType", "deviceId"],
      "properties": {
        "deviceType": { "type": "string", "enum": ["BTS", "CPE", "IDU"] },
        "deviceId":   { "type": "string" }
      }
    }
  }
}
