{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubr-nms.airtel.internal/schemas/kafka/processed-alarms.schema.json",
  "title": "ProcessedAlarmMessage",
  "description": "Kafka message on processed-alarms topic — deduplicated, correlated, root-cause enriched.",
  "type": "object",
  "required": ["alarmId", "deviceId", "alarmName", "severity", "state", "correlationGroup", "raisedAt"],
  "properties": {
    "alarmId":          { "type": "string", "format": "uuid" },
    "deviceId":         { "type": "string" },
    "deviceType":       { "type": "string" },
    "alarmName":        { "type": "string" },
    "alarmDescription": { "type": "string" },
    "severity":         { "type": "string" },
    "state":            { "type": "string" },
    "correlationGroup": { "type": "string" },
    "rootCause":        { "type": "string" },
    "acknowledged":     { "type": "boolean" },
    "raisedAt":         { "type": "string", "format": "date-time" },
    "processedAt":      { "type": "string", "format": "date-time" }
  }
}
