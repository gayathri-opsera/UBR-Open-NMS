{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubr-nms.airtel.internal/schemas/kafka/inventory-sync.schema.json",
  "title": "InventorySyncMessage",
  "description": "Inventory sync message from Mobinet/Telemedia integration. Exact format from BRD Section 4.4.",
  "type": "object",
  "required": ["serialNumber", "ipAddress", "macAddress", "model", "firmware"],
  "properties": {
    "systemName":   { "type": "string" },
    "ipAddress":    { "type": "string", "format": "ipv4" },
    "macAddress":   { "type": "string" },
    "serialNumber": { "type": "string" },
    "model":        { "type": "string" },
    "firmware":     { "type": "string" },
    "deviceType":   { "type": "string", "enum": ["BTS", "CPE", "IDU"] },
    "latitude":     { "type": "number" },
    "longitude":    { "type": "number" },
    "region":       { "type": "string" },
    "organizationId": { "type": "string" },
    "syncSource":   { "type": "string", "enum": ["mobinet", "telemedia", "manual"] },
    "syncedAt":     { "type": "string", "format": "date-time" }
  }
}
