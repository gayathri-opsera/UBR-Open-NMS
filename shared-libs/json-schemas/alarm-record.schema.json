{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubr-nms.airtel.internal/schemas/alarm-record.schema.json",
  "title": "AlarmRecord",
  "description": "Canonical alarm record as stored in MongoDB and forwarded to Netcool.",
  "type": "object",
  "required": ["alarmId", "deviceId", "alarmName", "severity", "state", "raisedAt"],
  "properties": {
    "alarmId":           { "type": "string", "format": "uuid" },
    "deviceId":          { "type": "string" },
    "deviceType":        { "type": "string", "enum": ["BTS", "CPE", "IDU"] },
    "alarmName":         { "type": "string" },
    "alarmDescription":  { "type": "string" },
    "severity":          { "type": "string", "enum": ["CRITICAL", "MAJOR", "MINOR", "WARNING", "INDETERMINATE", "CLEARED"] },
    "state":             { "type": "string", "enum": ["RAISED", "ACKNOWLEDGED", "CLEARED"] },
    "correlationGroup":  { "type": "string" },
    "rootCause":         { "type": "string" },
    "acknowledged":      { "type": "boolean", "default": false },
    "acknowledgedBy":    { "type": ["string", "null"] },
    "raisedAt":          { "type": "string", "format": "date-time" },
    "clearedAt":         { "type": ["string", "null"], "format": "date-time" },
    "ttlExpiry":         { "type": "string", "format": "date-time" }
  }
}
